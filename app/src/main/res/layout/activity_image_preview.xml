<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 全屏大图：FIT_CENTER 保持原图比例，不拉伸 -->
    <ImageView
        android:id="@+id/imageFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/imageTopBar"
        android:layout_alignParentBottom="true"
        android:scaleType="fitCenter"
        android:contentDescription="图片预览" />

    <!-- 加载中转圈 -->
    <ProgressBar
        android:id="@+id/imageLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- 顶部一行：返回 + 标题 -->
    <LinearLayout
        android:id="@+id/imageTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/btnImageBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 返回"
            android:textSize="14sp"
            android:textColor="@color/button_secondary_text"
            android:backgroundTint="@color/button_secondary_bg" />

        <TextView
            android:id="@+id/txtImageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="图片预览"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</RelativeLayout>
